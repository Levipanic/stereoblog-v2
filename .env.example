# Backend process and storage
API_HOST=127.0.0.1
API_PORT=8080
APP_ENV=development
DB_PATH=../data/blog.db
UPLOADS_PATH=../uploads

# Forwarded client IPs are ignored unless both values are configured.
TRUST_PROXY=false
TRUSTED_PROXIES=

# HTTP and uploads
JSON_BODY_LIMIT=256kb
GLOBAL_API_RATE_LIMIT_WINDOW_SECONDS=60
GLOBAL_API_RATE_LIMIT_MAX=240
UPLOAD_MAX_SIZE=25mb

# Admin secret must be changed in production. Generate one with: openssl rand -hex 32
ADMIN_SECRET=change-me

# Likes
LIKE_COOLDOWN_SECONDS=10
LIKE_RATE_LIMIT_MAX=20
# Empty salts inherit ADMIN_SECRET.
LIKE_IP_HASH_SALT=

# Comment validation and antispam
COMMENT_MAX_NAME_LENGTH=80
COMMENT_MAX_LENGTH=1000
COMMENT_MAX_URL_COUNT=4
COMMENT_MAX_TOKEN_LENGTH=120
COMMENT_MAX_REPEATED_CHAR_RUN=18
COMMENT_MAX_REPEATED_SYMBOL_RUN=10
COMMENT_MAX_REPEATED_TOKEN_RUN=12
COMMENT_RANDOM_TEXT_MIN_LENGTH=120
COMMENT_RANDOM_TOKEN_MIN_LENGTH=12
COMMENT_RANDOM_TOKEN_MIN_COUNT=4
COMMENT_RANDOM_TOKEN_MIN_SHARE=0.5
COMMENT_LOW_TOKEN_DIVERSITY_MIN_TOKEN_COUNT=24
COMMENT_LOW_TOKEN_DIVERSITY_CONTENT_MIN_LENGTH=180
COMMENT_LOW_TOKEN_DIVERSITY_THRESHOLD=0.14

# Comment rate limits and history
COMMENT_ATTEMPT_RATE_LIMIT_WINDOW_SECONDS=60
COMMENT_ATTEMPT_RATE_LIMIT_MAX=40
COMMENT_COOLDOWN_SECONDS=12
COMMENT_BURST_WINDOW_SECONDS=60
COMMENT_BURST_MAX=6
COMMENT_DUPLICATE_WINDOW_SECONDS=180
COMMENT_POST_RATE_LIMIT_WINDOW_SECONDS=120
COMMENT_POST_RATE_LIMIT_MAX=30
COMMENT_GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
COMMENT_GLOBAL_RATE_LIMIT_MAX=120
COMMENT_ATTEMPTS_TTL_HOURS=24

# Comment challenge and moderation
COMMENT_CHALLENGE_SALT=
COMMENT_CHALLENGE_TTL_SECONDS=1800
COMMENT_CHALLENGE_CLOCK_SKEW_SECONDS=60
COMMENT_MUTE_SECONDS=1800
COMMENT_HONEYPOT_MUTE_THRESHOLD=2
COMMENT_REJECTED_MUTE_THRESHOLD=12
COMMENT_ATTEMPT_CONTENT_MAX_LENGTH=500
COMMENT_ADMIN_LIST_LIMIT=40

# Posts
POST_MAX_BLOCKS=60
POST_MAX_TEXT_LENGTH=4000
POST_MAX_MEDIA_TEXT_LENGTH=500

# Admin and sessions
ADMIN_POST_RATE_LIMIT_WINDOW_SECONDS=300
ADMIN_POST_RATE_LIMIT_MAX=12
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_HASH_SALT=
ADMIN_SESSION_CLOCK_SKEW_SECONDS=60
ADMIN_LOGIN_RATE_LIMIT_MAX=6

# Nuxt server and public metadata
NUXT_INTERNAL_API_BASE=http://127.0.0.1:8080/api/v1
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_NAME=StereoDamage
NUXT_PUBLIC_SITE_HANDLE=@stereodamage
